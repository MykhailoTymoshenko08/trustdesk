# gemini api key (https://aistudio.google.com/apikey) - never commit the real one
GEMINI_API_KEY=
# model ids are read only from env
GEMMA_MODEL=gemma-4-31b-it
EMBED_MODEL=gemini-embedding-001
# mock = deterministic offline fixtures (tests, demo without network); live = real Gemini API
LLM_MODE=mock
# optional overrides
DATABASE_URL=sqlite:///./app.db
FEATURES_DIR=../docs/features
